# Environment Variables Template for app.ng

# Database Connection (Neon / Supabase Postgres / SQLite)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/app_ng?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/app_ng?sslmode=require"

# NextAuth / Auth Configuration
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Managed Real-time Provider (Pusher Channels / Supabase Realtime)
PUSHER_APP_ID="your-pusher-app-id"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# Object Storage (Vercel Blob / S3 / Supabase Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
